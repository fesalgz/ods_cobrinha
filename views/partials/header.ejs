<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Sistema OS
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Rajdhani:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="<%= (typeof globalConfig !== 'undefined' && globalConfig.tema_escuro === 1) ? 'dark-theme' : '' %>">
    <div class="app-container">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2><i class="fas fa-tools"></i>
                    <%= (typeof globalConfig !=='undefined' && globalConfig.nome_sistema) ? globalConfig.nome_sistema
                        : 'Cobrinha Games' %>
                </h2>
            </div>
            <nav class="sidebar-nav">
                <ul class="nav">
                    <li class="nav-item"><a href="/dashboard"
                            class="nav-link <%= typeof title !== 'undefined' && title === 'Dashboard' ? 'active' : '' %>"><i
                                class="fas fa-chart-line" style="width: 20px; text-align: center;"></i> Dashboard</a>
                    </li>
                    <li class="nav-item"><a href="/clientes"
                            class="nav-link <%= typeof title !== 'undefined' && title.includes('Cliente') ? 'active' : '' %>"><i
                                class="fas fa-users" style="width: 20px; text-align: center;"></i> Clientes</a></li>
                    <li class="nav-item"><a href="/os"
                            class="nav-link <%= typeof title !== 'undefined' && title.includes('Ordens') ? 'active' : '' %>"><i
                                class="fas fa-clipboard-list" style="width: 20px; text-align: center;"></i> Ordens de
                            Serviço</a></li>
                    <% if (typeof configAuthenticated !== 'undefined' && configAuthenticated) { %>
                    <li class="nav-item"><a href="/etiquetas"
                            class="nav-link <%= typeof title !== 'undefined' && title.includes('Etiquetas') ? 'active' : '' %>"><i
                                class="fas fa-tags" style="width: 20px; text-align: center;"></i> Etiquetas</a></li>
                    <% } %>
                    <% if (typeof user !=='undefined' && (user.role==='admin' || user.role==='gerente' )) { %>
                        <li class="nav-item"><a href="/funcionarios"
                                class="nav-link <%= typeof title !== 'undefined' && title.includes('Funcionário') ? 'active' : '' %>"><i
                                    class="fas fa-user-tie" style="width: 20px; text-align: center;"></i>
                                Funcionários</a></li>
                        <% } %>
                            <% if (typeof user !=='undefined' && user.role==='admin' ) { %>
                                <li class="nav-item"><a href="/configuracoes"
                                        class="nav-link <%= typeof title !== 'undefined' && title.includes('Configuraç') ? 'active' : '' %>"><i
                                            class="fas fa-cog" style="width: 20px; text-align: center;"></i>
                                        Configurações</a></li>
                                <% } %>
                </ul>
            </nav>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <h1>
                    <%= title %>
                </h1>
                <div class="user-info" style="display: flex; align-items: center; gap: 15px;">
                    <a href="#" onclick="toggleTema(); return false;" title="Alternar Modo Escuro"
                        style="color: #6c757d; text-decoration: none; font-size: 18px; display: flex; align-items: center;">
                        <i class="fas fa-moon"></i>
                    </a>
                </div>
            </header>
            <div class="content-wrapper">
                <script>
                    function toggleTema() {
                        fetch('/toggle-tema', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    if (data.tema_escuro === 1) {
                                        document.body.classList.add('dark-theme');
                                    } else {
                                        document.body.classList.remove('dark-theme');
                                    }
                                }
                            })
                            .catch(err => console.error('Erro ao alternar tema', err));
                    }
                </script>