<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Sistema OS
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Rajdhani:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="<%= (typeof globalConfig !== 'undefined' && globalConfig.tema_escuro === 1) ? 'dark-theme' : '' %>">
    <div class="app-container">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2><i class="fas fa-tools"></i>
                    <%= (typeof globalConfig !=='undefined' && globalConfig.nome_sistema) ? globalConfig.nome_sistema
                        : 'Cobrinha Games' %>
                </h2>
            </div>
            <nav class="sidebar-nav">
                <ul class="nav">
                    <li class="nav-item"><a href="/dashboard"
                            class="nav-link <%= typeof title !== 'undefined' && title === 'Dashboard' ? 'active' : '' %>"><i
                                class="fas fa-chart-line" style="width: 20px; text-align: center;"></i> Dashboard</a>
                    </li>
                    <li class="nav-item"><a href="/clientes"
                            class="nav-link <%= typeof title !== 'undefined' && title.includes('Cliente') ? 'active' : '' %>"><i
                                class="fas fa-users" style="width: 20px; text-align: center;"></i> Clientes</a></li>
                    <li class="nav-item"><a href="/os"
                            class="nav-link <%= typeof title !== 'undefined' && title.includes('Ordens') ? 'active' : '' %>"><i
                                class="fas fa-clipboard-list" style="width: 20px; text-align: center;"></i> Ordens de
                            Serviço</a></li>
                    <% if (typeof configAuthenticated !== 'undefined' && configAuthenticated) { %>
                    <li class="nav-item"><a href="/etiquetas"
                            class="nav-link <%= typeof title !== 'undefined' && title.includes('Etiquetas') ? 'active' : '' %>"><i
                                class="fas fa-tags" style="width: 20px; text-align: center;"></i> Etiquetas</a></li>
                    <% } %>
                    <% if (typeof user !=='undefined' && (user.role==='admin' || user.role==='gerente' )) { %>
                        <li class="nav-item"><a href="/funcionarios"
                                class="nav-link <%= typeof title !== 'undefined' && title.includes('Funcionário') ? 'active' : '' %>"><i
                                    class="fas fa-user-tie" style="width: 20px; text-align: center;"></i>
                                Funcionários</a></li>
                        <% } %>
                            <% if (typeof user !=='undefined' && user.role==='admin' ) { %>
                                <li class="nav-item"><a href="/configuracoes"
                                        class="nav-link <%= typeof title !== 'undefined' && title.includes('Configuraç') ? 'active' : '' %>"><i
                                            class="fas fa-cog" style="width: 20px; text-align: center;"></i>
                                        Configurações</a></li>
                                <% } %>
                </ul>
            </nav>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <h1>
                    <%= title %>
                </h1>
                <div class="user-info" style="display: flex; align-items: center; gap: 15px;">
                    <div id="updater-container" style="display: flex; align-items: center; gap: 10px;">
                        <span id="updater-status-text" style="font-size: 13px; color: var(--text-color, #6c757d); display: none; font-weight: 500;"></span>
                        <button id="btn-check-update" onclick="checkUpdate()" title="Buscar Atualização" style="padding: 0; font-size: 18px; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; border: none; background: transparent; color: var(--text-color, #6c757d); cursor: pointer; transition: all 0.2s;">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        <button id="btn-download-update" onclick="downloadUpdate()" title="Baixar Atualização" style="display: none; padding: 0; font-size: 16px; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; border: none; background: #28a745; color: white; cursor: pointer; box-shadow: 0 2px 4px rgba(40,167,69,0.2); transition: all 0.2s;">
                            <i class="fas fa-download"></i>
                        </button>
                    </div>
                    <a href="#" onclick="toggleTema(); return false;" title="Alternar Modo Escuro"
                        style="color: var(--text-color, #6c757d); text-decoration: none; font-size: 18px; display: flex; align-items: center;">
                        <i class="fas fa-moon"></i>
                    </a>
                </div>
            </header>
            <div class="content-wrapper">
                <script>
                    function checkUpdateStatus() {
                        fetch('/api/updater/status')
                            .then(res => res.json())
                            .then(data => {
                                const statusText = document.getElementById('updater-status-text');
                                const btnCheck = document.getElementById('btn-check-update');
                                const btnDownload = document.getElementById('btn-download-update');
                                const iconCheck = btnCheck ? btnCheck.querySelector('i') : null;

                                if (!statusText || !btnCheck || !btnDownload) return;

                                if (data.status === 'none') {
                                    statusText.style.display = 'none';
                                    btnCheck.style.display = 'flex';
                                    btnCheck.disabled = false;
                                    if (iconCheck) iconCheck.classList.remove('fa-spin');
                                    btnDownload.style.display = 'none';
                                } else if (data.status === 'checking') {
                                    statusText.style.display = 'none';
                                    btnCheck.style.display = 'flex';
                                    btnCheck.disabled = true;
                                    if (iconCheck) iconCheck.classList.add('fa-spin');
                                    btnDownload.style.display = 'none';
                                } else if (data.status === 'available') {
                                    statusText.style.display = 'none';
                                    btnCheck.style.display = 'none';
                                    btnDownload.style.display = 'flex';
                                } else if (data.status === 'downloading') {
                                    statusText.textContent = 'Baixando...';
                                    statusText.style.display = 'inline';
                                    btnCheck.style.display = 'none';
                                    btnDownload.style.display = 'none';
                                } else if (data.status === 'downloaded') {
                                    statusText.textContent = 'Atualização Pronta!';
                                    statusText.style.color = '#28a745';
                                    statusText.style.display = 'inline';
                                    btnCheck.style.display = 'none';
                                    btnDownload.style.display = 'none';
                                } else if (data.status === 'error') {
                                    statusText.textContent = 'Erro ao buscar update';
                                    statusText.style.color = '#dc3545';
                                    statusText.style.display = 'inline';
                                    btnCheck.style.display = 'flex';
                                    btnCheck.disabled = false;
                                    if (iconCheck) iconCheck.classList.remove('fa-spin');
                                    btnDownload.style.display = 'none';
                                }
                            })
                            .catch(err => console.error('Erro ao verificar status do updater', err));
                    }

                    function checkUpdate() {
                        const btnCheck = document.getElementById('btn-check-update');
                        const iconCheck = btnCheck.querySelector('i');
                        btnCheck.disabled = true;
                        iconCheck.classList.add('fa-spin');

                        fetch('/api/updater/check', { method: 'POST' })
                            .then(() => setTimeout(checkUpdateStatus, 1000));
                    }

                    function downloadUpdate() {
                        const btnDownload = document.getElementById('btn-download-update');
                        btnDownload.disabled = true;
                        btnDownload.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                        fetch('/api/updater/download', { method: 'POST' })
                            .then(() => setTimeout(checkUpdateStatus, 1000));
                    }

                    // Verifica o status periodicamente e no carregamento
                    setInterval(checkUpdateStatus, 3000);
                    setTimeout(checkUpdateStatus, 500);

                    function toggleTema() {
                        fetch('/toggle-tema', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    if (data.tema_escuro === 1) {
                                        document.body.classList.add('dark-theme');
                                    } else {
                                        document.body.classList.remove('dark-theme');
                                    }
                                }
                            })
                            .catch(err => console.error('Erro ao alternar tema', err));
                    }
                </script>